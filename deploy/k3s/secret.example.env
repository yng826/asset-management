# 복사해서 collector.env 로 저장 후 값 입력 (collector.env 는 .gitignore 대상, 커밋 금지)
#   kubectl -n asset-collector create secret generic collector-env --from-env-file=collector.env
# ⚠️ 값을 따옴표로 감싸지 말 것: --from-env-file 은 따옴표를 벗기지 않고 값에 그대로 포함한다
#    (#, $ 등 특수문자도 따옴표 없이 그대로 적으면 됨. 줄 맨 앞의 # 만 주석)
DB_USER=
DB_PASSWORD=
# 증권사 Open API (조회 전용, 선택). 없으면 broker-check 만 안내 후 실패하고 기존 수집은 영향 없음
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
