# 복사해서 collector.env 로 저장 후 값 입력 (collector.env 는 .gitignore 대상, 커밋 금지)
#   kubectl -n asset-collector create secret generic collector-env --from-env-file=collector.env
# ⚠️ 값을 따옴표로 감싸지 말 것: --from-env-file 은 따옴표를 벗기지 않고 값에 그대로 포함한다
#    (#, $ 등 특수문자도 따옴표 없이 그대로 적으면 됨. 줄 맨 앞의 # 만 주석)
DB_USER=
DB_PASSWORD=
# 증권사 Open API (조회 전용, 선택). 없으면 broker-check 만 안내 후 실패하고 기존 수집은 영향 없음
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 한국투자증권 (조회 전용, 선택). 앱키가 계좌마다 따로 발급되므로 계좌 하나당 아래 4줄을 번호를 올려 가며 추가한다.
#   KIS_<번호>_NAME 은 config/constants.py 의 계좌명, ACCOUNT 는 12345678-01 (앞 8자리-상품코드 2자리). 번호는 중간에 비어도 됨
#   연금저축·IRP 는 아직 잔고 조회에서 건너뜀 (4c 단계)
KIS_1_NAME=한투 일반
KIS_1_ACCOUNT=
KIS_1_APP_KEY=
KIS_1_APP_SECRET=
# KIS_2_NAME=한투 ISA
# KIS_2_ACCOUNT=
# KIS_2_APP_KEY=
# KIS_2_APP_SECRET=
