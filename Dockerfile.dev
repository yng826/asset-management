# syntax=docker/dockerfile:1.6
#
# 개발용 이미지
# - 핫 리로드(watchmedo) 포함
# - ruff (린터/포매터) 포함 — 코드 품질 자동 검사
# - 소스는 docker-compose.dev.yml 의 볼륨으로 마운트되므로
#   COPY 로 복제하지 않고 WORKDIR만 준비한다.
# - 의존성만 requirements-dev.txt 로 설치한다.
#
# 베이스 이미지 선택 이유:
#   python:3.11-slim  -> Debian 12 slim 기반. FinanceDataReader 가 C 확장
#   (numpy/pandas) 을 쓰므로 alpine 은 피한다.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 의존성만 먼저 복사하여 레이어 캐시 효율화
# (소스는 볼륨 마운트로 주입되므로 COPY 하지 않는다)
COPY requirements.txt requirements-dev.txt /app/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libmariadb-dev \
    libmariadb3 \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip \
    && pip install -r /app/requirements-dev.txt

# 컨테이너 내부 venv 쓰지 않음 (이미지에 포함). 호스트 venv 는 무시됨.
# 추가로 컨테이너 헬스체크/디버깅용 curl 설치 (개발 편의)

# 기본 실행 명령은 docker-compose.dev.yml 에서 override
# (watchmedo auto-restart 패턴 사용)
CMD ["python", "main.py"]
